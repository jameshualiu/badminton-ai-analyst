# Backend environment variables — copy to .env and fill in real values.
# Do NOT commit the real .env.

# --- Server ---
PORT=3000
# LOG_LEVEL controls pino verbosity: trace|debug|info|warn|error|silent
LOG_LEVEL=info

# --- Firebase Admin (service account) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes from the service-account key; they are unescaped at load time.
FIREBASE_PRIVATE_KEY=

# --- Storage: IDrive E2 / S3-compatible (referred to as R2_* for historical reasons) ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Worker trigger ---
MODAL_WEBHOOK_URL=
# Shared bearer token the worker checks on every webhook call (SEC-01).
# Must match the MODAL_WEBHOOK_SECRET entry in the Modal "badminton-ai-secrets" secret.
MODAL_WEBHOOK_SECRET=

# --- Rate limiting (BE-06) ---
# OPTIONAL. When unset, rate limiting uses an in-memory store — fine for local
# dev / a single instance, but on Vercel each serverless instance keeps its own
# counters, so the limits aren't enforced consistently. Set REDIS_URL to a shared
# Redis (e.g. an Upstash database's `rediss://` connection URL) in production so
# the limits hold across instances. If Redis is unreachable the limiter fails
# open (requests are allowed) rather than erroring.
REDIS_URL=
